{
  "name": "auto-flixer",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter=* dev",
    "dev:mock-app": "bun --filter=mock-app run dev",
    "types": "bun --filter=auto-flixer run types",
    "deploy": "bun --filter=auto-flixer run deploy",
    "test": "bun --filter=auto-flixer test",
    "test:local-email": "bun --filter=auto-flixer run test:local-email"
  }
}
